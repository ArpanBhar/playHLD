{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemforge.local/schemas/v1/simulation.schema.json",
  "title": "SystemForge simulation config version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["architecture", "workload", "snapshotIntervalUs"],
  "properties": {
    "architecture": { "$ref": "architecture.schema.json" },
    "workload": { "$ref": "workload.schema.json" },
    "snapshotIntervalUs": { "type": "integer", "minimum": 1, "maximum": 300000000 }
  }
}

