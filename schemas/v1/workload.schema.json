{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playhld.local/schemas/v1/workload.schema.json",
  "title": "playHLD workload version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seed", "entryNodeId", "durationUs", "drainTimeoutUs", "arrivalRateRps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seed": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 20 },
    "entryNodeId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "durationUs": { "type": "integer", "minimum": 1, "maximum": 300000000 },
    "drainTimeoutUs": { "type": "integer", "minimum": 0, "maximum": 30000000 },
    "arrivalRateRps": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "arrivalModel": { "enum": ["fixed", "poisson"] },
    "readFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "segments": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["startUs", "endUs", "rateRps"], "properties": { "startUs": { "type": "integer", "minimum": 0 }, "endUs": { "type": "integer", "minimum": 1 }, "rateRps": { "type": "integer", "minimum": 1, "maximum": 100000 } } } }
  }
}

