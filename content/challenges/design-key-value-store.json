  "workload":{"schemaVersion":1,"seed":"73","entryNodeId":"source","durationUs":10000000,"drainTimeoutUs":2000000,"arrivalRateRps":600,"readFraction":0.5,"scenario":"key_value","keySpace":96,"hotKeyFraction":0.7},
  "goals":[{"id":"correct","label":"Return correct outputs for at least 99% of requests","metric":"functional_correct_fraction","operator":"gte","target":99},{"id":"success","label":"Complete at least 99% of requests","metric":"success_fraction","operator":"gte","target":99},{"id":"p95","label":"P95 latency at or below 45 ms","metric":"p95_latency_us","operator":"lte","target":45},{"id":"p99","label":"P99 latency at or below 75 ms","metric":"p99_latency_us","operator":"lte","target":75}],
  "hints":["A datastore is required for correct puts and gets.","Two API instances behind a load balancer provide explicit horizontal capacity.","Multiple unreplicated databases do not share state in this model; route a key consistently if you experiment with several."],
