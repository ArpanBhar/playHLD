  "solution":{"explanation":"One load balancer splits traffic across two API instances, which share one database. The database holds the values; the API boxes add processing capacity without pretending they are replicas hidden inside one box.","architecture":{"schemaVersion":3,"nodes":[{"id":"source","kind":"source","label":"Clients","position":{"x":40,"y":200},"config":{"queueLimit":0}},{"id":"lb","kind":"load_balancer","label":"API load balancer","position":{"x":260,"y":200},"config":{"processingSlots":1,"maxInFlight":101,"meanServiceTimeUs":100,"queueLimit":100,"routingPolicy":"round_robin"}},{"id":"api","kind":"api","label":"KV API A","position":{"x":500,"y":90},"config":{"processingSlots":2,"maxInFlight":102,"meanServiceTimeUs":2500,"queueLimit":100}},{"id":"api2","kind":"api","label":"KV API B","position":{"x":500,"y":310},"config":{"processingSlots":2,"maxInFlight":102,"meanServiceTimeUs":2500,"queueLimit":100}},{"id":"db","kind":"database","label":"Values DB","position":{"x":760,"y":200},"config":{"processingSlots":4,"maxInFlight":104,"meanServiceTimeUs":3500,"queueLimit":100}}],"edges":[{"id":"s-lb","source":"source","target":"lb","route":"always","delayUs":0},{"id":"lb-a","source":"lb","target":"api","route":"always","delayUs":0},{"id":"lb-b","source":"lb","target":"api2","route":"always","delayUs":0},{"id":"a-d","source":"api","target":"db","route":"always","delayUs":0},{"id":"b-d","source":"api2","target":"db","route":"always","delayUs":0}]}}
