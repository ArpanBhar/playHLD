{
  "id": "telemetry-ingest",
  "version": 3,
  "title": "Telemetry at scale",
  "difficulty": "Advanced",
  "scenario": "Devices send 1,400 events per second. Build a reliable ingestion path and hold p95 and p99 latency down while using no more than the allotted component instances and processing slots.",
  "starter": {
    "schemaVersion": 3,
    "nodes": [
      {
        "id": "source",
        "kind": "source",
        "label": "Devices",
        "position": {
          "x": 80,
          "y": 170
        },
        "config": {
          "queueLimit": 0
        }
      },
      {
        "id": "api",
        "kind": "api",
        "label": "Ingest server",
        "position": {
          "x": 480,
          "y": 170
        },
        "config": {
          "meanServiceTimeUs": 2200,
          "queueLimit": 120,
          "processingSlots": 1,
          "maxInFlight": 121
        }
      }
    ],
    "edges": []
  },
  "workload": {
    "schemaVersion": 1,
    "seed": "46",
    "entryNodeId": "source",
    "durationUs": 10000000,
    "drainTimeoutUs": 1000000,
    "arrivalRateRps": 1400,
    "readFraction": 0
  },
  "goals": [
    {
      "id": "success",
      "label": "Complete at least 99% of events",
      "metric": "success_fraction",
      "operator": "gte",
      "target": 99
    },
    {
      "id": "p95",
      "label": "P95 latency at or below 50 ms",
      "metric": "p95_latency_us",
      "operator": "lte",
      "target": 50
    },
    {
      "id": "p99",
      "label": "P99 latency at or below 80 ms",
      "metric": "p99_latency_us",
      "operator": "lte",
      "target": 80
    }
  ],
  "hints": [
    "You can solve with any route that includes an API server.",
    "Compare the processing slots consumed by increasing server processing slots and adding a second route."
  ],
  "allowedKinds": [
    "source",
    "api",
    "load_balancer",
    "cache",
    "database",
    "message_queue",
    "worker",
    "object_storage",
    "cdn"
  ],
  "resourceBudget": {
    "maxNodes": 6,
    "maxSlots": 10,
    "maxByKind": {
      "source": 1,
      "api": 3,
      "load_balancer": 1,
      "cache": 1,
      "database": 1,
      "message_queue": 1,
      "worker": 2,
      "object_storage": 1,
      "cdn": 1
    },
    "maxProcessingSlotsPerNode": 4
  },
  "componentSpecs": {
    "api": {
      "meanServiceTimeUs": 2200,
      "queueLimit": 120
    },
    "load_balancer": {
      "meanServiceTimeUs": 100,
      "queueLimit": 120
    },
    "cache": {
      "meanServiceTimeUs": 250,
      "queueLimit": 120,
      "hitRate": 0.8
    },
    "database": {
      "meanServiceTimeUs": 6000,
      "queueLimit": 120
    },
    "message_queue": {
      "meanServiceTimeUs": 1000,
      "queueLimit": 120
    },
    "worker": {
      "meanServiceTimeUs": 1200,
      "queueLimit": 120
    },
    "object_storage": {
      "meanServiceTimeUs": 1500,
      "queueLimit": 120
    },
    "cdn": {
      "meanServiceTimeUs": 150,
      "queueLimit": 120,
      "hitRate": 0.8
    }
  },
  "solution": {
    "explanation": "The balancer splits device traffic between two ingest API instances. They feed one queue and one worker, keeping each instance and its capacity visible.",
    "architecture": {
      "schemaVersion": 3,
      "nodes": [
        {
          "id": "source",
          "kind": "source",
          "label": "Devices",
          "position": {
            "x": 80,
            "y": 170
          },
          "config": {
            "queueLimit": 0
          }
        },
        {
          "id": "balancer",
          "kind": "load_balancer",
          "label": "Load balancer",
          "position": {
            "x": 300,
            "y": 210
          },
          "config": {
            "meanServiceTimeUs": 100,
            "queueLimit": 120,
            "routingPolicy": "round_robin",
            "processingSlots": 1,
            "maxInFlight": 121
          }
        },
        {
          "id": "api",
          "kind": "api",
          "label": "Ingest API A",
          "position": {
            "x": 550,
            "y": 95
          },
          "config": {
            "meanServiceTimeUs": 2200,
            "queueLimit": 120,
            "processingSlots": 2,
            "maxInFlight": 122
          }
        },
        {
          "id": "api-b",
          "kind": "api",
          "label": "Ingest API B",
          "position": {
            "x": 550,
            "y": 325
          },
          "config": {
            "meanServiceTimeUs": 2200,
            "queueLimit": 120,
            "processingSlots": 2,
            "maxInFlight": 122
          }
        },
        {
          "id": "queue",
          "kind": "message_queue",
          "label": "Events queue",
          "position": {
            "x": 800,
            "y": 210
          },
          "config": {
            "meanServiceTimeUs": 1000,
            "queueLimit": 120,
            "processingSlots": 2,
            "maxInFlight": 122
          }
        },
        {
          "id": "worker",
          "kind": "worker",
          "label": "Event worker",
          "position": {
            "x": 1040,
            "y": 210
          },
          "config": {
            "meanServiceTimeUs": 1200,
            "queueLimit": 120,
            "processingSlots": 2,
            "maxInFlight": 122
          }
        }
      ],
      "edges": [
        {
          "id": "solution-1",
          "source": "source",
          "target": "balancer",
          "route": "always",
          "delayUs": 0
        },
        {
          "id": "solution-2",
          "source": "balancer",
          "target": "api",
          "route": "always",
          "delayUs": 0
        },
        {
          "id": "solution-3",
          "source": "balancer",
          "target": "api-b",
          "route": "always",
          "delayUs": 0
        },
        {
          "id": "solution-4",
          "source": "api",
          "target": "queue",
          "route": "always",
          "delayUs": 0
        },
        {
          "id": "solution-5",
          "source": "api-b",
          "target": "queue",
          "route": "always",
          "delayUs": 0
        },
        {
          "id": "solution-6",
          "source": "queue",
          "target": "worker",
          "route": "always",
          "delayUs": 0
        }
      ]
    }
  }
}
