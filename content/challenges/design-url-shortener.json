  "solution":{"explanation":"The load balancer sends requests to two API instances. Each API routes redirects through the shared stateful cache and creates to the database. Cache misses read the database and fill the cache; writes invalidate matching cached keys.","architecture":{"schemaVersion":3,"nodes":[{"id":"source","kind":"source","label":"Clients","position":{"x":40,"y":220},"config":{"queueLimit":0}},{"id":"lb","kind":"load_balancer","label":"API load balancer","position":{"x":260,"y":220},"config":{"processingSlots":1,"maxInFlight":101,"meanServiceTimeUs":100,"queueLimit":100,"routingPolicy":"round_robin"}},{"id":"api","kind":"api","label":"API A","position":{"x":490,"y":100},"config":{"processingSlots":2,"maxInFlight":102,"meanServiceTimeUs":2000,"queueLimit":100}},{"id":"api2","kind":"api","label":"API B","position":{"x":490,"y":330},"config":{"processingSlots":2,"maxInFlight":102,"meanServiceTimeUs":2000,"queueLimit":100}},{"id":"cache","kind":"cache","label":"Redirect cache","position":{"x":740,"y":120},"config":{"processingSlots":2,"maxInFlight":102,"meanServiceTimeUs":300,"queueLimit":100,"cacheCapacity":32}},{"id":"db","kind":"database","label":"Mappings DB","position":{"x":970,"y":250},"config":{"processingSlots":4,"maxInFlight":104,"meanServiceTimeUs":4000,"queueLimit":100}}],"edges":[{"id":"s-lb","source":"source","target":"lb","route":"always","delayUs":0},{"id":"lb-a","source":"lb","target":"api","route":"always","delayUs":0},{"id":"lb-b","source":"lb","target":"api2","route":"always","delayUs":0},{"id":"a-read","source":"api","target":"cache","route":"read","delayUs":0},{"id":"a-write","source":"api","target":"db","route":"write","delayUs":0},{"id":"b-read","source":"api2","target":"cache","route":"read","delayUs":0},{"id":"b-write","source":"api2","target":"db","route":"write","delayUs":0},{"id":"cache-miss","source":"cache","target":"db","route":"cache_miss","delayUs":0}]}}
