{
  "id":"design-url-shortener","version":1,"title":"Design a URL Shortener","difficulty":"Intermediate",
  "scenario":"Build a URL shortener that creates short-code mappings and redirects existing codes. The published traffic is 80% redirects over 64 keys, with 80% of reads concentrated on eight hot keys. The datastore starts with those 64 mappings. A create request must persist its mapping; a redirect must return the current value. Cache hits are measured from actual keys, capacity and TTL. Meet correctness and tail-latency goals within the component budget.",
  "starter":{"schemaVersion":3,"nodes":[{"id":"source","kind":"source","label":"Clients","position":{"x":60,"y":220},"config":{"queueLimit":0}},{"id":"api","kind":"api","label":"API service","position":{"x":380,"y":220},"config":{"processingSlots":1,"maxInFlight":101,"meanServiceTimeUs":2000,"queueLimit":100}}],"edges":[]},
  "workload":{"schemaVersion":1,"seed":"71","entryNodeId":"source","durationUs":10000000,"drainTimeoutUs":2000000,"arrivalRateRps":800,"readFraction":0.8,"scenario":"url_shortener","keySpace":64,"hotKeyFraction":0.8},
  "goals":[{"id":"correct","label":"Return correct outputs for at least 99% of requests","metric":"functional_correct_fraction","operator":"gte","target":99},{"id":"success","label":"Complete at least 99% of requests","metric":"success_fraction","operator":"gte","target":99},{"id":"p95","label":"P95 latency at or below 35 ms","metric":"p95_latency_us","operator":"lte","target":35},{"id":"p99","label":"P99 latency at or below 60 ms","metric":"p99_latency_us","operator":"lte","target":60}],
  "hints":["A database or object store is required to persist creates and answer cache misses.","Connect an API read route to a cache and a write route to the datastore. A cache miss route should lead to the datastore.","A load balancer can split traffic across two API instances. Each box is one instance."],
